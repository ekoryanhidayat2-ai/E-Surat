# PORT: Port HTTP tempat server Express berjalan (default: 3000)
PORT="3000"

# NODE_ENV: Mode eksekusi aplikasi ("development" atau "production")
NODE_ENV="development"

# APP_URL: URL tempat aplikasi di-host (diisi otomatis oleh AI Studio / layanan cloud)
APP_URL="http://localhost:3000"

# DB_PATH: Lokasi file database SQLite persuratan (gunakan volume persisten saat deploy)
DB_PATH="./data/persuratan.db"

# UPLOAD_DIR: Direktori penyimpanan berkas lampiran PDF/gambar yang diunggah
UPLOAD_DIR="./data/uploads"

# LOG_DIR: Direktori penyimpanan log error terstruktur (error.log)
LOG_DIR="./data/logs"

# ALERT_WEBHOOK_URL: (Opsional) URL webhook Slack/Discord/Telegram bridge untuk notifikasi error server
ALERT_WEBHOOK_URL=""

# GEMINI_API_KEY: Kunci API server-side untuk fitur kecerdasan buatan (analisis lampiran, draf surat, & asisten arsip).
# Diisi melalui Settings > Secrets pada AI Studio atau variabel lingkungan server (jangan kirim ke frontend).
GEMINI_API_KEY=""
